# /etc/default/jetson-collector — 수집 서비스 환경설정
# 값을 바꾼 뒤: sudo systemctl restart jetson-collector

# ── 식별 ─────────────────────────────────────────────────────────────────
COLLECTOR_DEVICE_ID=jetson-orin-nano-1
COLLECTOR_PROJECT_ID=customfood-soup

# ── 센서 ─────────────────────────────────────────────────────────────────
# mock = 모의 센서만(하드웨어 없이 개발·시연)
# auto = 실기기(ISX031F /dev/video4·Gemini 2 USB·I²C/SPI 센서 5대) + 모의 센서는 mock_* ID로 추가
# real = 실기기·미지원 항목만
COLLECTOR_SENSOR_MODE=auto
# GMSL2 카메라: 경로(/dev/video4) 또는 gmsl:<포트>. /dev/video 번호는 Gemini 2를 꽂은 시점에 따라 밀리므로
# (실측: Gemini가 video0~5, GMSL이 video6·7) Sensing SG4A 보드에서는 포트로 지정한다. 순서대로 cam_rgb_0, cam_rgb_1 …
COLLECTOR_V4L2_DEVICES=gmsl:0,gmsl:1
# Gemini 2가 여러 대일 때 대상 시리얼. 비우면 처음 탐색된 Gemini 2.
COLLECTOR_ORBBEC_SERIAL=
# 세션 설정에 fps가 없을 때 Gemini 2 color·depth·IR의 기본 fps(5/10/15/30). 0이면 SDK 기본 30.
# 30 fps는 depth+IR만 약 115 MB/s(30분 200 GB) — 세션에서 바꾸려면 per_sensor.cam_depth_0.fps
COLLECTOR_ORBBEC_FPS=10
COLLECTOR_PROBE_TTL=10

# ── I²C·SPI 센서 5대 (docs/jetson-five-sensor-guide.md) ──────────────────
# 버스 번호·CS 핀·기준 저항은 **실물에서 확인한 뒤** 주석을 풀고 채운다. 비워 두면 해당 센서는
# status에 connected=false + 이유로 나가고 열리지 않는다. 확인: tools/sensor_check.py buses / mux
#COLLECTOR_I2C_THERMAL_BUS=
COLLECTOR_I2C_THERMAL_MUX_ADDR=0x70
COLLECTOR_THERMAL_CHANNELS=0,1
COLLECTOR_THERMAL_RATE_HZ=2
# 장치 refresh rate(서브페이지 주기). 목표 Hz × 2 × 같은 버스의 카메라 수 이상: 0.5,1,2,4,8,16,32,64
COLLECTOR_THERMAL_REFRESH_HZ=8
COLLECTOR_THERMAL_READ_RETRIES=2
#COLLECTOR_I2C_POINT_BUS=
COLLECTOR_I2C_POINT_MUX_ADDR=0x70
COLLECTOR_POINT_CHANNELS=0,1
COLLECTOR_POINT_RATE_HZ=1
# MAX31865 CS = 별도 GPIO의 Blinka 핀 이름(J12 물리 15번이면 D22). 하드웨어 CS0(24번, CE0) 금지.
#COLLECTOR_PT100_CS_PIN=
# 보드 실물 기준 저항(Ω). 430을 가정하지 말 것.
#COLLECTOR_PT100_REF_OHMS=
COLLECTOR_PT100_WIRES=3
COLLECTOR_PT100_RATE_HZ=1
COLLECTOR_SENSOR_FAIL_LIMIT=5
# 시스템 Jetson.GPIO 2.1.7은 Orin Nano "Super" 보드를 못 알아본다(import board 실패) — 모델명을 넘긴다.
COLLECTOR_JETSON_MODEL_NAME=JETSON_ORIN_NANO

# ── 저장 ─────────────────────────────────────────────────────────────────
COLLECTOR_DATA_ROOT=/home/ubuntu/collector-data
COLLECTOR_MIN_FREE_BYTES=2000000000
COLLECTOR_WRITER_QUEUE_MAX=64
COLLECTOR_INDEX_FLUSH_SEC=1
COLLECTOR_INDEX_FLUSH_LINES=200
COLLECTOR_JPEG_QUALITY=90
# none | after_stop
COLLECTOR_CHECKSUM=after_stop

# ── 통계·감시 주기(초) ─────────────────────────────────────────────────
COLLECTOR_STATS_INTERVAL=1
COLLECTOR_SYSTEM_INTERVAL=5

# ── 생명주기 ─────────────────────────────────────────────────────────────
COLLECTOR_STOP_WAIT=120
COLLECTOR_SENSOR_RETRY=2
# 정상 종료(system/shutdown) 마지막 단계에 실행할 명령. 비우면 저장 완료 후 로그만 남긴다.
# 예: sudo -n systemctl poweroff   (ubuntu 사용자에 NOPASSWD 설정 필요)
COLLECTOR_POWEROFF_CMD=

# ── 서버 ─────────────────────────────────────────────────────────────────
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=8000

# ── 로그 ─────────────────────────────────────────────────────────────────
# 기본은 journald(표준출력). 파일로도 남기려면 COLLECTOR_LOG_FILE을 주면 크기 회전한다.
COLLECTOR_LOG_LEVEL=INFO
#COLLECTOR_LOG_FILE=/home/ubuntu/collector-data/collector.log
COLLECTOR_LOG_MAX_MB=5
COLLECTOR_LOG_BACKUPS=3
# 수집 중 N초마다 요약 한 줄(프레임마다 찍지 않는다)
COLLECTOR_LOG_SUMMARY_INTERVAL=30
