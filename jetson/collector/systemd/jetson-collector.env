# /etc/default/jetson-collector — 수집 서비스 환경설정
# 값을 바꾼 뒤: sudo systemctl restart jetson-collector

# ── 식별 ─────────────────────────────────────────────────────────────────
COLLECTOR_DEVICE_ID=jetson-orin-nano-1
COLLECTOR_PROJECT_ID=customfood-soup

# ── 센서 ─────────────────────────────────────────────────────────────────
# mock = 모의 센서만(하드웨어 없이 개발·시연)
# auto = 실기기(ISX031F /dev/video4) + 미지원 항목(Gemini 2·MLX) 보고 + 모의 센서는 mock_* ID로 추가
# real = 실기기·미지원 항목만
COLLECTOR_SENSOR_MODE=auto
COLLECTOR_V4L2_DEVICES=/dev/video4
COLLECTOR_PROBE_TTL=10

# ── 저장 ─────────────────────────────────────────────────────────────────
COLLECTOR_DATA_ROOT=/home/ubuntu/collector-data
COLLECTOR_MIN_FREE_BYTES=2000000000
COLLECTOR_WRITER_QUEUE_MAX=64
COLLECTOR_INDEX_FLUSH_SEC=1
COLLECTOR_INDEX_FLUSH_LINES=200
COLLECTOR_JPEG_QUALITY=90
# none | after_stop
COLLECTOR_CHECKSUM=after_stop

# ── 통계·감시 주기(초) ─────────────────────────────────────────────────
COLLECTOR_STATS_INTERVAL=1
COLLECTOR_SYSTEM_INTERVAL=5

# ── 생명주기 ─────────────────────────────────────────────────────────────
COLLECTOR_STOP_WAIT=120
COLLECTOR_SENSOR_RETRY=2
# 정상 종료(system/shutdown) 마지막 단계에 실행할 명령. 비우면 저장 완료 후 로그만 남긴다.
# 예: sudo -n systemctl poweroff   (ubuntu 사용자에 NOPASSWD 설정 필요)
COLLECTOR_POWEROFF_CMD=

# ── 서버 ─────────────────────────────────────────────────────────────────
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=8000
