{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CookingStatus",
  "description": "cooking/status MQTT 토픽 페이로드. docs/data-schema.md 참고.",
  "type": "object",
  "required": ["timestamp", "stage", "temperature_c", "elapsed_sec", "ai_detection", "alerts"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "recipe_id": { "type": "string" },
    "stage": { "type": "string", "enum": ["ingredient_add", "heating", "boiling", "done"] },
    "temperature_c": { "type": "number" },
    "target_temp_c": { "type": "number" },
    "elapsed_sec": { "type": "integer", "minimum": 0 },
    "ai_detection": {
      "type": "object",
      "required": ["boil_state", "confidence"],
      "properties": {
        "boil_state": { "type": "string", "enum": ["none", "simmer", "rolling_boil"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "alerts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "examples": [
    {
      "timestamp": "2026-07-10T14:30:00Z",
      "recipe_id": "kimchi_jjigae_v1",
      "stage": "boiling",
      "temperature_c": 98.5,
      "target_temp_c": 100.0,
      "elapsed_sec": 620,
      "ai_detection": { "boil_state": "rolling_boil", "confidence": 0.94 },
      "alerts": ["overflow_risk"]
    }
  ]
}
