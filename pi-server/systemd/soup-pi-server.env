# /etc/default/soup-pi-server — 관리 서버 환경설정
# 값을 바꾼 뒤: sudo systemctl restart soup-pi-server

# ── Jetson 연동 ──────────────────────────────────────────────────────────
# mock = 모의 Jetson(하드웨어 없이 화면·감시 개발/시연)
# http = 실제 Jetson 수집 서비스 (docs/pi-jetson-api.md 계약)
SOUP_JETSON_MODE=mock
SOUP_JETSON_URL=http://192.168.0.51:8000
# 호스트 생존 확인용 TCP 포트 (수집 서비스가 죽어도 OS가 살아 있으면 열려 있는 포트)
SOUP_JETSON_PROBE_PORT=22

# ── 감시 주기·판정 ───────────────────────────────────────────────────────
SOUP_PROBE_INTERVAL=2
SOUP_PROBE_TIMEOUT=2
SOUP_STALE_AFTER=8
SOUP_LINK_LOST_CONFIRM=20

# ── 전원 제어 ────────────────────────────────────────────────────────────
# unsupported = 회로 미구성(기본). 조작 버튼은 '미지원'으로 표시되고 501을 반환한다.
# mock        = 모의 전원(모의 Jetson 전용). 실제 전원과 무관함이 화면에 표시된다.
SOUP_POWER_MODE=unsupported

# ── 서버 ─────────────────────────────────────────────────────────────────
SOUP_HOST=0.0.0.0
SOUP_PORT=8100
SOUP_DB_PATH=/home/yj-rpi/customfood-soup-automation/pi-server/data/pi-server.db
SOUP_SITE_NAME=국·탕 실험장치 관리 서버
